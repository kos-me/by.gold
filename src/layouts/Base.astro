---
import Analytics from '../components/Analytics.astro';
import { NAV, SITE_NAME, SITE_TAGLINE, MINFIN_URL } from '../lib/site.ts';
import { DATA_DIR, status, USING_OVERRIDDEN_DATA } from '../lib/data.ts';
import { minskDateTime } from '../lib/date.ts';
import { formatRuDateShort } from '../lib/date.ts';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /** Path of the current page, so the nav item can be highlighted. */
  path: string;
  /** Narrow column for text-led pages. */
  narrow?: boolean;
}

const { title, description, path, narrow = false } = Astro.props;

const canonical = new URL(path, Astro.site ?? 'https://gold.by').href;

/*
 * The "checked at" stamp.
 *
 * The mockup's footer reads "данные проверены 28 июля 2026, 09:40". That date
 * cannot come from the build time: a build is not a check of the source, and
 * the line would become a falsehood of exactly the kind this whole site exists
 * to prevent. Until the worker records a real stamp, show the source instead
 * of a time.
 */
const checked =
  status.last_checked === null ? null : minskDateTime(new Date(status.last_checked));

const googleVerification = import.meta.env['PUBLIC_GOOGLE_SITE_VERIFICATION'] ?? null;
const yandexVerification = import.meta.env['PUBLIC_YANDEX_VERIFICATION'] ?? null;

const origin = new URL(canonical).origin;

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE_NAME,
  url: `${origin}/`,
  inLanguage: 'ru',
  description:
    'Официальная цена скупки золота в Беларуси, установленная Министерством финансов, ' +
    'и порядок оценки изделия при приёмке.',
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <link
      rel="preload"
      href="/fonts/onest-700.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta name="theme-color" content="#1b1e21" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="ru_BY" />
    <meta property="og:image" content={`${new URL('/images/hallmark-585.webp', canonical).href}`} />
    <meta property="og:image:alt" content="Оттиск 585 внутри шинки кольца" />
    <meta name="twitter:card" content="summary_large_image" />

    {
      /*
       * Ownership verification for Search Console and Yandex Webmaster. No
       * code means no tag: a made-up code would verify nothing while looking
       * like something configured.
       */
      googleVerification !== null && (
        <meta name="google-site-verification" content={googleVerification} />
      )
    }
    {
      yandexVerification !== null && (
        <meta name="yandex-verification" content={yandexVerification} />
      )
    }

    {/*
      Structured data is deliberately thin: only "what this site is". A
      Product/Offer schema with a price would be a lie here — the state sets
      the price, the site sells nothing, and in the "no figure" state a
      machine-readable price would also be stale.
    */}
    <script type="application/ld+json" is:inline set:html={JSON.stringify(structuredData)} />
  </head>

  <body>
    {
      /*
       * A build on substituted data must be obvious at a glance. Such a build
       * must never reach production quietly: the figures in fixtures are made
       * up, and preventing exactly that is what this site is for.
       */
      USING_OVERRIDDEN_DATA && (
        <div class="fixture-banner" role="alert">
          <strong>Сборка на тестовых данных.</strong> Все цифры на странице выдуманы и
          ничего не значат. Каталог: <code>{DATA_DIR}</code>
        </div>
      )
    }

    <header class="masthead">
      <div class="masthead__inner">
        <a class="wordmark" href="/">gold<span class="wordmark__tld">.by</span></a>
        <nav class="nav" aria-label="Разделы сайта">
          {
            NAV.map((item) => (
              <a href={item.href} aria-current={item.href === path ? 'page' : undefined}>
                {item.label}
              </a>
            ))
          }
        </nav>
      </div>
    </header>

    <main class={`wrap page${narrow ? ' page--narrow' : ''}`}>
      <slot />

      <footer class="colophon">
        <span>{SITE_NAME} — {SITE_TAGLINE}</span>
        {
          checked === null ? (
            <span class="colophon__stamp">
              источник — <a href={MINFIN_URL} rel="noopener">minfin.gov.by</a>
            </span>
          ) : (
            <span class="colophon__stamp">
              данные проверены {formatRuDateShort(checked.date)}, {checked.time}
            </span>
          )
        }
      </footer>
    </main>

    <Analytics />
  </body>
</html>
