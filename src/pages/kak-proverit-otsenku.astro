---
import Base from '../layouts/Base.astro';
import { IF_SOMETHING_WRONG, STEPS } from '../lib/procedure.ts';
import { BUYBACK_RULES_URL } from '../lib/site.ts';

const description =
  'Что должно происходить у стойки скупки: пробу определяют при вас, весы ' +
  'стоят так, чтобы вы видели массу, снятые вставки возвращают. Цена за ' +
  'грамм не обсуждается — её установил Минфин.';
---

<Base
  title="Как проверить оценку в скупке золота | gold.by"
  description={description}
  path="/kak-proverit-otsenku"
  narrow
>
  <section class="section section--first prose">
    <div class="label label--lg slug">/kak-proverit-otsenku</div>
    <h1>Как проверить оценку в скупке</h1>
    <p>
      Цена за грамм в скупке не обсуждается — её установил Минфин, и ниже неё
      не платит никто. Обсуждаются два других числа: проба и зачётная масса.
      Вот что должно происходить у стойки.
    </p>
  </section>

  <div class="steps">
    {
      STEPS.map((step) => (
        <div class="step">
          <span class="step__n">{step.n}</span>
          <div>
            <div class="step__title">{step.title}</div>
            <p>{step.text}</p>
          </div>
        </div>
      ))
    }
  </div>

  <section class="section section--tight">
    <figure class="figure card">
      <div class="figure__frame" style="height:210px">
        <img
          src="/images/scale-display.webp"
          alt="Дисплей весов с массой изделия в граммах"
          width={900}
          height={352}
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption>Весы ставят так, чтобы вы могли сами убедиться в массе.</figcaption>
    </figure>
  </section>

  <section class="section section--tight">
    <div class="callout">
      <div class="label label--stamp">если что-то не так</div>
      <p>{IF_SOMETHING_WRONG}</p>
    </div>
  </section>

  {/*
    The source, stated to the visitor rather than only in a code comment.
    Everything above says buyers "должны", "обязаны", "не вправе" — a reader is
    entitled to know which act says so and to check it. The known limit is
    stated too: the amendments have not been read, so the page says what it
    rests on and no more.
  */}
  <section class="section section--tight">
    <p class="source-note">
      Написано по Правилам скупки у граждан драгоценных металлов и драгоценных
      камней в изделиях и ломе — <a href={BUYBACK_RULES_URL} rel="noopener">
        постановление Совета Министров от 12 сентября 2011 г. № 1211</a>. Мы
      читали первоначальный текст; изменения 2017, 2023 и 2025 годов мы не
      сверяли — сводный текст доступен только по подписке. Спорную ситуацию
      сверяйте с самими Правилами по ссылке.
    </p>
  </section>
</Base>
