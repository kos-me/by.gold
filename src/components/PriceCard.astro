---
/**
 * The price block: the large figure (or its honest absence), the hallmark and
 * the fineness table.
 *
 * With no decree in force, hatching occupies the figure's place — not a zero
 * and not a dash across the whole card. The space is filled, but not by a number.
 */
import Hallmark from './Hallmark.astro';
import { absenceNote } from '../lib/copy.ts';
import { TARIFF_TABLE_NOTE } from '../lib/copy.ts';
import { formatByn } from '../lib/calc.ts';
import { MAX_BUILD_AGE_DAYS } from '../lib/date.ts';
import { FINENESSES, HEADLINE_FINENESS, type FinenessKey } from '../lib/schema.ts';
import { headlinePrice, type TariffState } from '../lib/tariff.ts';

interface Props {
  state: TariffState;
}

const { state } = Astro.props;
const record = state.current;
const headline = record === null ? null : headlinePrice(record);

/*
 * Which finenesses the table shows. With an act in force, exactly the ones it
 * names. Without one, the canonical list of finenesses the site covers, all
 * dashed. That is not invented data: it is a list of rows, not of prices.
 */
const rows: readonly FinenessKey[] =
  record === null
    ? FINENESSES
    : FINENESSES.filter((key) => record.prices_byn_per_gram[key] !== undefined);

const absent = absenceNote(state);

/*
 * The date after which this build stops being truthful. Only set when a
 * figure is actually on the page and the act names an end date; an act with
 * no stated expiry is replaced rather than expiring, so there is no date to
 * check against.
 */
const staleGuardExpiry = state.status === 'valid' ? (record?.stated_expiry ?? null) : null;

/*
 * The build's own date, and how long it may be trusted.
 *
 * This is the check that covers an act naming no end date — nothing about such
 * an act ever expires, so the expiry check above can never fire for it, and a
 * forgotten build would show its price indefinitely. Emitted whenever a figure
 * is on the page, which is exactly when there is something to withhold.
 *
 * `state.asOf` is the Minsk date the state was computed for, which is the date
 * this build speaks for.
 */
const showsAFigure = state.status === 'valid';
const buildDate = showsAFigure ? state.asOf : null;
---

<section class="section section--first">
  <div
    class="card card--shadow"
    data-stale-guard={showsAFigure ? '' : undefined}
    data-stale-expiry={staleGuardExpiry ?? undefined}
    data-build-date={buildDate ?? undefined}
    data-build-max-age-days={buildDate === null ? undefined : String(MAX_BUILD_AGE_DAYS)}
  >
    {
      /*
       * Rendered whenever a figure is being shown. It is the fallback the
       * browser swaps in when this build can no longer be trusted — either the
       * act's end date has passed, or the build itself is too old to vouch for
       * an act that names no end date. See src/scripts/staleness.ts.
       *
       * Both notes are server-rendered and hidden; the script reveals whichever
       * check fired, so no sentence is assembled in JavaScript.
       */
      showsAFigure && (
        <div class="price price--withheld" data-when-stale hidden>
          <div>
            <div class="label label--lg">{HEADLINE_FINENESS} проба, за грамм</div>
            <div class="price__absent">
              <span class="price__absent-title">Цифры пока нет</span>
              <span class="price__absent-note" data-stale-note="expired" hidden>
                срок постановления истёк
              </span>
              <span class="price__absent-note" data-stale-note="build_age" hidden>
                не можем подтвердить, что цифра действующая
              </span>
            </div>
          </div>
          <Hallmark record={null} />
        </div>
      )
    }
    {
      headline === null ? (
        <div class="price price--withheld">
          <div>
            <div class="label label--lg">{HEADLINE_FINENESS} проба, за грамм</div>
            <div class="price__absent">
              <span class="price__absent-title">Цифры пока нет</span>
              {absent !== '' && <span class="price__absent-note">{absent}</span>}
            </div>
          </div>
          <Hallmark record={null} />
        </div>
      ) : (
        <div class="price" data-when-fresh>
          <div>
            <div class="label label--lg">{headline.fineness} проба, за грамм</div>
            <p class="price__figure">
              <span class="price__value">{formatByn(headline.price)}</span>
              <span class="price__unit">BYN</span>
            </p>
          </div>
          <Hallmark record={record} />
        </div>
      )
    }

    <div class="tariffs__head">
      <h2>Цена скупки по пробам</h2>
      <span class="label">BYN за грамм лигатурной массы</span>
    </div>

    {
      rows.map((fineness) => {
        const price = record?.prices_byn_per_gram[fineness];
        const isHeadline = fineness === headline?.fineness;
        return (
          <div
            data-tariff-row={fineness}
            class:list={[
              'tariff-row',
              price === undefined && 'tariff-row--muted',
              isHeadline && 'tariff-row--selected',
            ]}
          >
            <span class="tariff-row__fineness">{fineness}</span>
            <span class="tariff-row__note">
              {fineness === HEADLINE_FINENESS ? 'чаще всего' : ''}
            </span>
            <span class="tariff-row__price">{price === undefined ? '—' : formatByn(price)}</span>
          </div>
        );
      })
    }

    <div class="card__foot">{TARIFF_TABLE_NOTE}</div>
  </div>

  {/*
    Unconditional on purpose. Astro only hoists a <script> it can see
    statically, and the guard costs a few hundred bytes; the script itself
    does nothing when [data-stale-guard] is absent, which is every state
    except "a figure is shown and its act has an end date".
  */}
  <script>
    import '../scripts/staleness.ts';
  </script>
</section>
