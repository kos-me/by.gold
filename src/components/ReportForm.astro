---
/**
 * The form for reporting an error in a figure.
 *
 * States from the mockup: idle, invalid, sending, sent, dupe, failed. All of
 * them sit in the markup at once and are swapped by script — that way the
 * "didn't send" state appears alongside the preserved text instead of losing it.
 *
 * Without JavaScript the form posts normally to the same address; the worker
 * accepts both form-encoded and JSON bodies — see worker/.
 */
import { MINFIN_URL } from '../lib/site.ts';

interface Props {
  /** Turnstile site key. Empty means no widget is rendered (local development). */
  turnstileSiteKey: string | null;
}

const { turnstileSiteKey } = Astro.props;
---

<div data-report-form>
  <form
    class="card"
    id="report-form"
    method="post"
    action="/api/contact"
    style="padding:18px 20px;display:grid;gap:12px"
    data-state="idle"
    novalidate
  >
    <div>
      <label class="label" for="report-email" style="display:block;margin-bottom:7px">
        Ваша почта
      </label>
      <input
        class="calc__input"
        id="report-email"
        name="email"
        type="email"
        placeholder="name@mail.by"
        autocomplete="email"
        required
        style="font-size:15px;font-weight:400"
      />
    </div>

    <div>
      <label class="label" for="report-note" style="display:block;margin-bottom:7px">
        Что не так
      </label>
      <textarea
        class="calc__input"
        id="report-note"
        name="note"
        rows="4"
        required
        minlength="12"
        placeholder="Например: в скупке назвали цену ниже постановления"
        style="font-size:15px;font-weight:400;font-family:inherit;resize:vertical"></textarea>
    </div>

    {/*
      Bot honeypot. Not `type=hidden` — a naive bot fills only the fields it
      sees as ordinary ones in the markup. And not `.sr-only` either: that tool
      exists precisely to expose content to a screen reader, whereas here the
      field must be invisible to everyone, assistive technology included.
    */}
    <div class="honeypot" aria-hidden="true">
      <label for="report-city">Не заполняйте это поле</label>
      <input id="report-city" name="city" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <div data-report-invalid hidden>
      <div
        style="display:flex;gap:9px;align-items:flex-start;padding:10px 12px;border-radius:9px;background:var(--warn-bg);border:1px solid var(--warn-line)"
      >
        <span class="label" style="color:var(--warn-label);padding-top:2px">проверьте</span>
        <span
          style="font-size:13.5px;line-height:1.5;color:var(--warn-ink)"
          data-report-invalid-text></span>
      </div>
    </div>

    {
      turnstileSiteKey !== null && (
        <div
          class="cf-turnstile"
          data-sitekey={turnstileSiteKey}
          data-theme="light"
          data-size="flexible"
        />
      )
    }

    <div style="display:flex;flex-wrap:wrap;gap:12px 16px;align-items:center">
      <button
        type="submit"
        data-report-submit
        style="justify-self:start;padding:11px 20px;border:0;border-radius:9px;font-weight:600;font-size:15px;cursor:pointer;background:var(--link);color:#fff"
      >
        Отправить
      </button>
      <span class="note">Ответим на почту. Обычно в течение дня.</span>
    </div>
  </form>

  {/* accepted */}
  <div class="card" data-report-sent hidden style="border:1.5px solid var(--stamp)">
    <div style="padding:18px 20px;background:var(--wash);border-bottom:1px solid var(--stamp-line)">
      <div class="label label--stamp">сообщение принято</div>
      <div
        style="font-family:var(--font-display);font-weight:700;font-size:17px;margin:8px 0 7px"
      >
        Проверим и ответим на <span data-report-email>указанный адрес</span>
      </div>
      <p style="font-size:14px;line-height:1.6;color:var(--ink-strong)">
        Сверим ваше сообщение с действующим постановлением. Если расхождение
        на нашей стороне — исправим цифру и напишем, что изменилось.
      </p>
    </div>
    <div
      style="padding:14px 20px;display:flex;flex-wrap:wrap;gap:10px 18px;align-items:center;justify-content:space-between"
    >
      <span class="history__act">обращение <span data-report-ticket></span></span>
      <button type="button" data-report-reset class="chip" style="font-weight:600">
        Сообщить ещё об одном
      </button>
    </div>
  </div>

  {/* already under review */}
  <div class="card" data-report-dupe hidden>
    <div style="padding:18px 20px;border-bottom:1px solid var(--line-inner)">
      <div class="label">уже в работе</div>
      <div
        style="font-family:var(--font-display);font-weight:700;font-size:17px;margin:8px 0 7px"
      >
        Об этом расхождении нам уже сообщили
      </div>
      <p
        style="font-size:14px;line-height:1.6;color:var(--ink-strong)"
        data-report-dupe-text
      ></p>
    </div>
    <div
      style="padding:14px 20px;display:flex;flex-wrap:wrap;gap:10px 18px;align-items:center;justify-content:space-between"
    >
      <a href={MINFIN_URL} rel="noopener" style="font-size:13.5px;font-weight:600">
        Открыть постановление на minfin.gov.by →
      </a>
      <button type="button" data-report-reset class="chip" style="font-weight:600">
        Сообщить о другом
      </button>
    </div>
  </div>

  {/* didn't send */}
  <div class="card" data-report-failed hidden style="border-color:var(--warn-card-line)">
    <div
      style="padding:18px 20px;background:var(--warn-bg-2);border-bottom:1px solid var(--warn-line-2)"
    >
      <div class="label" style="color:var(--warn-label)">не отправилось</div>
      <div
        style="font-family:var(--font-display);font-weight:700;font-size:17px;margin:8px 0 7px"
      >
        Письмо не ушло — форма не отвечает
      </div>
      <p style="font-size:14px;line-height:1.6;color:var(--warn-ink)">
        Текст сохранён, он никуда не пропал. Нажмите «Повторить» — обычно со
        второй попытки уходит. Если не уходит и со второй, форма сейчас
        недоступна: попробуйте позже, текст останется в поле.
      </p>
    </div>
    <div
      style="padding:14px 20px;display:flex;flex-wrap:wrap;gap:10px 18px;align-items:center;justify-content:space-between"
    >
      <span class="note">Форма — единственный способ связи с нами.</span>
      <button type="button" data-report-retry class="chip" style="font-weight:600">
        Повторить
      </button>
    </div>
  </div>
</div>

{
  turnstileSiteKey !== null && (
    <script
      is:inline
      src="https://challenges.cloudflare.com/turnstile/v0/api.js"
      async
      defer
    />
  )
}

<script>
  import '../scripts/report-form.ts';
</script>
