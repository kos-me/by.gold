---
/**
 * A photograph in a card. Three on the whole site, all of them the subject's
 * real materials: a hallmark, reagent on a touchstone, a scale display.
 *
 * `loading="lazy"` on all of them: none is part of the LCP.
 */
interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  /** Frame height in the layout — the image is cropped to it. */
  frameHeight: number;
}

const { src, alt, width, height, frameHeight } = Astro.props;
---

<figure class="figure card">
  <div class="figure__frame" style={`height:${frameHeight}px`}>
    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </div>
  <figcaption><slot /></figcaption>
</figure>
