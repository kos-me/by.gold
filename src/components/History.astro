---
/**
 * Price history: a sparkline and a compact table.
 *
 * Driven entirely by past records. No records means no section at all: an
 * empty "no history yet" card says nothing and takes up room. The sparkline
 * appears from three points — there is nothing to draw with two.
 */
import { formatByn } from '../lib/calc.ts';
import { formatRuDate, formatRuPeriod } from '../lib/date.ts';
import { HEADLINE_FINENESS, type TariffRecord } from '../lib/schema.ts';
import { priceSeries, type TariffState } from '../lib/tariff.ts';

interface Props {
  state: TariffState;
}

const { state } = Astro.props;

const series = priceSeries(state, HEADLINE_FINENESS);
const showSparkline = series.length >= 3;

/*
 * Bar height. The floor sits some way below the minimum, otherwise the
 * cheapest month renders as zero and the series reads as a collapse.
 */
const values = series.map((entry) => entry.price);
const max = values.length === 0 ? 0 : Math.max(...values);
const min = values.length === 0 ? 0 : Math.min(...values);
const floor = min - (max - min) * 0.25 - 0.0001;
const barHeight = (price: number): number => Math.round(13 + ((price - floor) / (max - floor)) * 39);

const rows = [...series].reverse();
const isWithheld = state.status !== 'valid';

/*
 * What to print for the period.
 *
 * Records read from a year-archive page have no end date — the archive does
 * not publish the act text — so only the start is stated. Deriving the end
 * from the next act's start would assume the two are contiguous, which is
 * exactly the sort of small invention this project refuses.
 */
function period(record: TariffRecord): string {
  return record.transcribed_from === 'archive'
    ? `с ${formatRuDate(record.effective_from)}`
    : formatRuPeriod(record.effective_from, record.stated_expiry);
}
---

{
  series.length > 0 && (
    <section class="section">
      <h2 class="section__title">Как менялась цена</h2>
      <div class="history">
        {showSparkline && (
          <div class="sparkline" aria-hidden="true">
            {series.map((entry, index) => (
              <div
                class:list={[
                  'sparkline__bar',
                  index === series.length - 1 &&
                    (isWithheld ? 'sparkline__bar--last-muted' : 'sparkline__bar--last'),
                ]}
                style={`height:${barHeight(entry.price)}px`}
              />
            ))}
          </div>
        )}

        {rows.map((entry) => (
          <div class="history__row">
            <span class="history__price tabular">{formatByn(entry.price)} BYN</span>
            <span class="history__period">{period(entry.record)}</span>
            <span class="history__act">№ {entry.record.act_number}</span>
          </div>
        ))}

        <p class="history__foot">
          {HEADLINE_FINENESS} проба, BYN за грамм. Постановления выходят нерегулярно.
        </p>
      </div>
    </section>
  )
}
