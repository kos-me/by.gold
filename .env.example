# Build-time values only. Copy to `.env` and fill in.
#
#   cp .env.example .env
#
# Everything here is PUBLIC: it ends up in the built HTML. Nothing secret
# belongs in this file. Real secrets go to the worker via
# `wrangler secret put` — see DEPLOY.md.
#
# `.env` is gitignored. Leaving a value unset is a supported state: the
# feature simply does not render, which is deliberate.

# Turnstile public key. Unset → no widget. In production the worker then
# refuses the submission, and the form shows "didn't send".
# PUBLIC_TURNSTILE_SITE_KEY=

# GA4 measurement id. Unset → neither the tag nor the consent banner renders.
# PUBLIC_GA4_ID=

# Ownership verification. Unset → no meta tag is emitted at all.
# PUBLIC_GOOGLE_SITE_VERIFICATION=
# PUBLIC_YANDEX_VERIFICATION=

# Canonical origin. Defaults to https://gold.by.
# SITE_URL=https://gold.by
