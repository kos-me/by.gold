{
  "name": "gold-by",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "gold.by — официальная цена скупки золота в Беларуси",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run validate:data && astro build",
    "build:only": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "astro check",
    "validate:data": "vitest run tests/data-integrity.test.ts",
    "dev:valid": "GOLD_DATA_DIR=tests/fixtures/valid-state astro dev",
    "dev:expired": "GOLD_DATA_DIR=tests/fixtures/expired-state astro dev",
    "build:valid": "GOLD_DATA_DIR=tests/fixtures/valid-state astro build --outDir dist-valid",
    "build:expired": "GOLD_DATA_DIR=tests/fixtures/expired-state astro build --outDir dist-expired",
    "check": "npm run typecheck && npm run test && npm run build:only"
  },
  "dependencies": {
    "astro": "^7.1.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^26.1.2",
    "puppeteer-core": "^25.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
